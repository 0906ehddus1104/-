<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>운동 기록장</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* Layout idea: one phone-width column, calendar and set table as the working surface, bottom tab bar.
   Color comes from competition plates: 20 kg blue for training volume, 15 kg yellow for body weight. */
:root{
  --bg:#eceef2;
  --surface:#ffffff;
  --ink:#151a23;
  --muted:#5d6676;
  --line:#d5d9e1;
  --accent:#1c4fd6;
  --accent-ink:#ffffff;
  --accent-soft:#e2e9fb;
  --weight:#a86a00;
  --danger:#c22f2f;
  --font-body:"IBM Plex Sans KR","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  --font-num:"Barlow Condensed","IBM Plex Sans KR",system-ui,sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0e1117;--surface:#171b24;--ink:#eceff5;--muted:#97a1b2;--line:#2a313e;
    --accent:#7aa2ff;--accent-ink:#0a1022;--accent-soft:#1b2742;--weight:#e2ac40;--danger:#ff7f76;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0e1117;--surface:#171b24;--ink:#eceff5;--muted:#97a1b2;--line:#2a313e;
  --accent:#7aa2ff;--accent-ink:#0a1022;--accent-soft:#1b2742;--weight:#e2ac40;--danger:#ff7f76;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.5;-webkit-text-size-adjust:100%}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.app{height:100%;max-width:600px;margin:0 auto;display:flex;flex-direction:column}
header{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:14px 16px 10px}
header h1{margin:0;font-size:20px;font-weight:700;letter-spacing:-.01em}
#status{font-size:12px;color:var(--muted);background:none;border:0;padding:0;text-align:right}
#status.err{color:var(--danger);text-decoration:underline}
main{flex:1;overflow-y:auto;padding:4px 16px 24px;display:flex;flex-direction:column;gap:14px}
nav{display:grid;grid-template-columns:repeat(4,1fr);background:var(--surface);border-top:1px solid var(--line)}
nav button{background:none;border:0;padding:10px 4px 12px;display:flex;flex-direction:column;align-items:center;gap:2px;color:var(--muted);font-size:13px;font-weight:500;border-top:3px solid transparent;margin-top:-1px}
nav button[aria-current="page"]{color:var(--accent);border-top-color:var(--accent);font-weight:700}
nav svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

h2{margin:0;font-size:17px;font-weight:700;text-wrap:balance}
h3{margin:0;font-size:16px;font-weight:600}
.sub{margin:2px 0 0;color:var(--muted);font-size:13px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:12px}
.row{display:flex;align-items:center;gap:8px}
.row .grow{flex:1;min-width:0}
.empty{color:var(--muted);font-size:14px;margin:0}
.num{font-family:var(--font-num);font-variant-numeric:tabular-nums;letter-spacing:.01em}

form.add{display:flex;gap:8px}
input[type=text],input[type=number],input[type=date]{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;min-width:0;width:100%}
input:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px var(--accent-soft)}
.btn{background:var(--accent);color:var(--accent-ink);border:0;border-radius:8px;padding:10px 16px;font-weight:600;white-space:nowrap}
.btn.ghost{background:none;color:var(--accent);border:1px solid var(--line)}
.btn.small{padding:6px 10px;font-size:13px}
.del{background:none;border:0;color:var(--muted);font-size:13px;padding:6px 8px;border-radius:6px;white-space:nowrap}
.del.armed{background:var(--danger);color:#fff;font-weight:600}

ul.plain,ol.plain{list-style:none;margin:0;padding:0}
.list li{display:flex;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid var(--line)}
.list li:last-child{border-bottom:0;padding-bottom:0}
.list li:first-child{padding-top:0}
.idx{font-family:var(--font-num);font-weight:600;color:var(--muted);width:22px;font-size:16px}

.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:600}
.chip .badge{font-family:var(--font-num);font-weight:700;font-size:14px;opacity:.85}

/* calendar */
.cal-head{display:flex;align-items:center;gap:6px}
.cal-head h2{flex:1;font-family:var(--font-num);font-size:24px;font-weight:600}
.icon-btn{background:none;border:1px solid var(--line);border-radius:8px;width:36px;height:36px;font-size:18px;line-height:1}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.cal .wd{text-align:center;font-size:12px;color:var(--muted);padding:2px 0 4px}
.cal button{background:none;border:0;border-radius:8px;aspect-ratio:1/0.82;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-family:var(--font-num);font-size:18px;font-weight:500;position:relative}
.cal button::after{content:"";width:5px;height:5px;border-radius:50%;background:transparent}
.cal button.has::after{background:var(--accent)}
.cal button.today{box-shadow:inset 0 0 0 1.5px var(--line)}
.cal button.sel{background:var(--accent);color:var(--accent-ink);font-weight:700}
.cal button.sel.has::after{background:var(--accent-ink)}

/* exercise log */
.ex{border:1px solid var(--line);border-radius:10px;background:var(--surface);overflow:hidden}
.ex.open{border-color:var(--accent)}
.ex-head{width:100%;background:none;border:0;padding:13px 14px;display:flex;align-items:center;gap:10px;text-align:left}
.ex-name{flex:1;font-weight:600;min-width:0}
.ex-sum{color:var(--muted);font-size:14px;white-space:nowrap}
.ex-sum.done{color:var(--accent);font-weight:600}
.ex-body{border-top:1px solid var(--line);padding:12px 14px 14px;display:flex;flex-direction:column;gap:12px}
.stepper{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--muted)}
.stepper .ctl{margin-left:auto;display:flex;align-items:center;gap:4px}
.stepper button{width:38px;height:38px;border-radius:8px;border:1px solid var(--line);background:var(--surface);font-size:20px;line-height:1}
.stepper output{font-family:var(--font-num);font-size:26px;font-weight:700;color:var(--ink);min-width:36px;text-align:center}
.sets li{display:grid;grid-template-columns:26px 1fr auto 1fr auto;align-items:center;gap:8px;padding:4px 0;font-size:14px;color:var(--muted)}
.sets input{text-align:right;font-family:var(--font-num);font-size:20px;font-weight:600;padding:6px 10px;color:var(--ink)}
.hint{margin:0;font-size:13px;color:var(--muted)}
.exlist{display:flex;flex-direction:column;gap:8px}

/* trends */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stat{border:1px solid var(--line);border-radius:8px;padding:8px 10px}
.stat dt{font-size:12px;color:var(--muted)}
.stat dd{margin:0;font-family:var(--font-num);font-size:24px;font-weight:700;line-height:1.15}
.stat dd small{font-size:13px;font-weight:500;color:var(--muted);margin-left:2px}
dl{margin:0}
.chart{position:relative;min-height:60px}
.chart svg{display:block;width:100%;touch-action:pan-y}
.chart text{font-family:var(--font-num);font-size:13px;fill:var(--muted)}
.chart .tip{position:absolute;top:0;pointer-events:none;background:var(--ink);color:var(--bg);font-size:12px;padding:3px 8px;border-radius:6px;white-space:nowrap;transform:translateX(-50%);display:none}
.wform{display:grid;grid-template-columns:1fr 1fr auto;gap:8px}
@media (max-width:400px){.wform{grid-template-columns:1fr 1fr}.wform .btn{grid-column:1/-1}.stat dd{font-size:20px}}
@media (prefers-reduced-motion:no-preference){.chip,.cal button,.del{transition:background-color .12s,color .12s}}
</style>
</head>
<body>
<div class="app">
  <header>
    <h1>운동 기록장</h1>
    <button id="status" type="button" disabled>불러오는 중…</button>
  </header>
  <main id="main"><p class="empty">기록을 불러오는 중…</p></main>
  <nav aria-label="탭">
    <button type="button" data-tab="exercises"><svg viewBox="0 0 24 24"><path d="M3 12h18M6 8v8M18 8v8M3.5 10v4M20.5 10v4"/></svg>종목</button>
    <button type="button" data-tab="routines"><svg viewBox="0 0 24 24"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>루틴</button>
    <button type="button" data-tab="log"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>기록</button>
    <button type="button" data-tab="trends"><svg viewBox="0 0 24 24"><path d="M4 18l5-6 4 3 7-9"/><path d="M4 21h16"/></svg>추세</button>
  </nav>
</div>
<script>
(function(){
"use strict";
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad=n=>String(n).padStart(2,'0');
const ymd=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const parse=s=>{const a=s.split('-').map(Number);return new Date(a[0],a[1]-1,a[2])};
const md=s=>{const a=s.split('-');return Number(a[1])+'/'+Number(a[2])};
const fmt=n=>(Math.round(n*10)/10).toLocaleString('ko-KR');
const uid=p=>p+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const WD=['일','월','화','수','목','금','토'];
const TODAY=ymd(new Date());
const TABS=['exercises','routines','log','trends'];

/* ---------- data ---------- */
let S={exercises:[],routines:[],weights:{}};   // doc "core"
const L={};                                     // month "YYYY-MM" -> {days:{date:{routineId,entries:{exId:[{kg,reps}]}}}}
const store={mode:'local',col:null};
const pend={};

function applyDoc(id,data){
  const c=JSON.parse(JSON.stringify(data||{}));
  if(id==='core'){S={exercises:c.exercises||[],routines:c.routines||[],weights:c.weights||{}};}
  else if(id.indexOf('logs-')===0){L[id.slice(5)]={days:c.days||{}};}
}
function body(key){return key==='core'?S:L[key.slice(5)]}
function loadLocal(){
  try{
    for(let i=0;i<localStorage.length;i++){
      const k=localStorage.key(i);
      if(k&&k.indexOf('wl:')===0){applyDoc(k.slice(3),JSON.parse(localStorage.getItem(k)));}
    }
  }catch(e){}
}
function setStatus(text,err){
  const el=$('#status');el.textContent=text;el.classList.toggle('err',!!err);el.disabled=!err;
}
function idleStatus(){setStatus(store.mode==='cloud'?'저장됨':'이 기기에만 저장됨');}
function save(key){
  if(store.mode==='local'){
    try{localStorage.setItem('wl:'+key,JSON.stringify(body(key)));}catch(e){setStatus('저장할 수 없음',false);}
    return;
  }
  const p=pend[key]||(pend[key]={timer:null,busy:false,dirty:false});
  p.dirty=true;clearTimeout(p.timer);p.timer=setTimeout(()=>flush(key),600);
  setStatus('저장 중…');
}
async function flush(key,retried){
  const p=pend[key];if(!p||p.busy||!p.dirty)return;
  p.busy=true;p.dirty=false;let failed=false;
  try{await store.col.doc(key).set(JSON.parse(JSON.stringify(body(key))));}
  catch(e){
    p.dirty=true;failed=true;
    if(!retried&&e&&e.code==='unavailable'){p.busy=false;setTimeout(()=>flush(key,true),800+Math.random()*800);return;}
  }
  p.busy=false;
  if(failed){setStatus('저장 실패 · 눌러서 다시 시도',true);return;}
  if(p.dirty){flush(key);return;}
  if(!Object.values(pend).some(x=>x.dirty||x.busy))idleStatus();
}
$('#status').addEventListener('click',()=>{setStatus('저장 중…');Object.keys(pend).forEach(k=>flush(k));});

function getDay(date,create){
  const m=date.slice(0,7);
  if(!L[m]){if(!create)return null;L[m]={days:{}};}
  if(!L[m].days[date]){if(!create)return null;L[m].days[date]={routineId:null,entries:{}};}
  const d=L[m].days[date];if(!d.entries)d.entries={};return d;
}
const saveDay=date=>save('logs-'+date.slice(0,7));
const volume=sets=>(sets||[]).reduce((a,s)=>a+(Number(s.kg)||0)*(Number(s.reps)||0),0);
const hasReps=sets=>(sets||[]).some(s=>Number(s.reps)>0);
const dayHasLog=d=>!!d&&Object.values(d.entries||{}).some(hasReps);
function allDays(){
  const out=[];
  Object.keys(L).forEach(m=>Object.keys(L[m].days||{}).forEach(dt=>out.push([dt,L[m].days[dt]])));
  return out.sort((a,b)=>a[0]<b[0]?-1:1);
}
function series(exId){
  return allDays().filter(x=>hasReps(x[1].entries&&x[1].entries[exId]))
    .map(x=>({date:x[0],v:volume(x[1].entries[exId])}));
}
function lastRecord(exId,before){
  const a=allDays().filter(x=>x[0]<before&&hasReps(x[1].entries&&x[1].entries[exId]));
  return a.length?{date:a[a.length-1][0],sets:a[a.length-1][1].entries[exId]}:null;
}
const exById=id=>S.exercises.find(e=>e.id===id);

/* ---------- ui state ---------- */
const now=new Date();
const ui={tab:'log',sel:TODAY,vy:now.getFullYear(),vm:now.getMonth(),openEx:null,pick:null,trendEx:null,ready:false};

function setTab(t,fromHash){
  if(TABS.indexOf(t)<0)return;
  ui.tab=t;
  if(!fromHash){try{history.replaceState(null,'','#'+t);}catch(e){location.hash=t;}}
  render();
}
window.addEventListener('hashchange',()=>setTab(location.hash.slice(1),true));

/* ---------- render ---------- */
function render(){
  document.querySelectorAll('nav button').forEach(b=>{
    if(b.dataset.tab===ui.tab)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');
  });
  if(!ui.ready)return;
  const m=$('#main');
  m.innerHTML=({exercises:viewExercises,routines:viewRoutines,log:viewLog,trends:viewTrends})[ui.tab]();
  if(ui.tab==='trends')drawTrends();
}

function viewExercises(){
  const list=S.exercises.map((e,i)=>
    '<li><span class="idx">'+(i+1)+'</span><span class="grow">'+esc(e.name)+'</span>'+
    '<button type="button" class="del" data-act="delEx" data-id="'+e.id+'">삭제</button></li>').join('');
  return '<div><h2>운동 종목</h2><p class="sub">하는 운동을 자유롭게 적어 두면 루틴과 기록에서 골라 쓸 수 있어요.</p></div>'+
    '<form class="add" data-form="addEx"><input type="text" id="new-ex" maxlength="40" placeholder="예: 스쿼트" autocomplete="off" aria-label="종목 이름">'+
    '<button class="btn" type="submit">추가</button></form>'+
    '<section class="card">'+(list?'<ul class="plain list">'+list+'</ul>':
      '<p class="empty">아직 등록한 종목이 없어요. 위에 이름을 적고 추가를 누르세요.</p>'+
      '<div><button type="button" class="btn ghost small" data-act="seed">예시 종목과 루틴 넣어 보기</button></div>')+'</section>';
}

function viewRoutines(){
  const cards=S.routines.map(r=>{
    const ids=r.exIds.filter(exById);
    const items=ids.map((id,i)=>'<li><span class="idx">'+(i+1)+'</span><span class="grow">'+esc(exById(id).name)+'</span>'+
      '<button type="button" class="del" data-act="rmFromRoutine" data-r="'+r.id+'" data-id="'+id+'" aria-label="'+esc(exById(id).name)+' 빼기">빼기</button></li>').join('');
    const open=ui.pick===r.id;
    const picker=open?'<div class="chips">'+S.exercises.map(e=>{
      const n=ids.indexOf(e.id);
      return '<button type="button" class="chip" aria-pressed="'+(n>=0)+'" data-act="toggleInRoutine" data-r="'+r.id+'" data-id="'+e.id+'">'+
        (n>=0?'<span class="badge">'+(n+1)+'</span>':'')+esc(e.name)+'</button>';}).join('')+'</div>':'';
    return '<article class="card"><div class="row"><h3 class="grow">'+esc(r.name)+'</h3><span class="sub num">'+ids.length+'종목</span>'+
      '<button type="button" class="del" data-act="delRoutine" data-id="'+r.id+'">삭제</button></div>'+
      (items?'<ol class="plain list">'+items+'</ol>':'<p class="empty">아직 고른 종목이 없어요.</p>')+
      '<div><button type="button" class="btn ghost small" data-act="togglePick" data-id="'+r.id+'">'+(open?'고르기 닫기':'종목 고르기')+'</button></div>'+
      picker+'</article>';
  }).join('');
  const noEx=!S.exercises.length;
  return '<div><h2>운동 루틴</h2><p class="sub">루틴 이름을 만들고, 종목을 누른 순서대로 담아요.</p></div>'+
    '<form class="add" data-form="addRoutine"><input type="text" id="new-routine" maxlength="30" placeholder="예: 하체A" autocomplete="off" aria-label="루틴 이름">'+
    '<button class="btn" type="submit">추가</button></form>'+
    (noEx?'<p class="empty">먼저 종목 탭에서 운동 종목을 등록하세요.</p>':'')+
    (cards||'<section class="card"><p class="empty">아직 만든 루틴이 없어요.</p></section>');
}

function sumText(sets){
  return sets&&sets.length?sets.length+'세트 · '+fmt(volume(sets))+' kg':'기록 없음';
}
function viewLog(){
  const first=new Date(ui.vy,ui.vm,1),off=(first.getDay()+6)%7,dim=new Date(ui.vy,ui.vm+1,0).getDate();
  let cells=['월','화','수','목','금','토','일'].map(w=>'<span class="wd">'+w+'</span>').join('');
  for(let i=0;i<off;i++)cells+='<span></span>';
  for(let d=1;d<=dim;d++){
    const dt=ui.vy+'-'+pad(ui.vm+1)+'-'+pad(d);
    const cls=[dt===ui.sel?'sel':'',dt===TODAY?'today':'',dayHasLog(getDay(dt))?'has':''].join(' ').trim();
    cells+='<button type="button" class="'+cls+'" data-act="day" data-d="'+dt+'"'+(dt===ui.sel?' aria-pressed="true"':'')+'>'+d+'</button>';
  }
  const day=getDay(ui.sel),sd=parse(ui.sel);
  const routine=day&&S.routines.find(r=>r.id===day.routineId);
  const chips=S.routines.map(r=>'<button type="button" class="chip" aria-pressed="'+(!!routine&&routine.id===r.id)+'" data-act="pickRoutine" data-id="'+r.id+'">'+esc(r.name)+'</button>').join('');
  let ids=routine?routine.exIds.filter(exById):[];
  if(day)Object.keys(day.entries).forEach(id=>{if(ids.indexOf(id)<0&&exById(id)&&day.entries[id].length)ids.push(id);});
  const exs=ids.map(id=>{
    const sets=(day&&day.entries[id])||[],open=ui.openEx===id;
    let bodyHtml='';
    if(open){
      const last=lastRecord(id,ui.sel);
      const rows=sets.map((s,i)=>'<li><span class="idx">'+(i+1)+'</span>'+
        '<input type="number" inputmode="decimal" min="0" step="any" id="kg-'+id+'-'+i+'" data-in="kg" data-id="'+id+'" data-i="'+i+'" value="'+(s.kg===''||s.kg==null?'':s.kg)+'" aria-label="'+(i+1)+'세트 무게"><span>kg ×</span>'+
        '<input type="number" inputmode="numeric" min="0" step="1" id="reps-'+id+'-'+i+'" data-in="reps" data-id="'+id+'" data-i="'+i+'" value="'+(s.reps===''||s.reps==null?'':s.reps)+'" aria-label="'+(i+1)+'세트 반복 횟수"><span>회</span></li>').join('');
      bodyHtml='<div class="ex-body"><div class="stepper"><span>세트 수</span><span class="ctl">'+
        '<button type="button" data-act="setDec" data-id="'+id+'" aria-label="세트 줄이기">−</button>'+
        '<output>'+sets.length+'</output>'+
        '<button type="button" data-act="setInc" data-id="'+id+'" aria-label="세트 늘리기">+</button></span></div>'+
        (rows?'<ol class="plain sets">'+rows+'</ol>':'<p class="hint">+ 를 눌러 세트 수를 정하세요.</p>')+
        (last?'<p class="hint">지난 기록 '+md(last.date)+' · '+last.sets.map(s=>fmt(Number(s.kg)||0)+'kg×'+(Number(s.reps)||0)).join(', ')+
          (sets.length?'':' <button type="button" class="btn ghost small" data-act="copyLast" data-id="'+id+'">그대로 불러오기</button>')+'</p>':'')+
        '</div>';
    }
    return '<li class="ex'+(open?' open':'')+'"><button type="button" class="ex-head" data-act="openEx" data-id="'+id+'" aria-expanded="'+open+'">'+
      '<span class="ex-name">'+esc(exById(id).name)+'</span><span class="ex-sum num'+(hasReps(sets)?' done':'')+'" id="sum-'+id+'">'+sumText(sets)+'</span></button>'+bodyHtml+'</li>';
  }).join('');
  return '<section class="card"><div class="cal-head"><h2>'+ui.vy+'. '+pad(ui.vm+1)+'</h2>'+
    '<button type="button" class="btn ghost small" data-act="goToday">오늘</button>'+
    '<button type="button" class="icon-btn" data-act="prevMonth" aria-label="이전 달">‹</button>'+
    '<button type="button" class="icon-btn" data-act="nextMonth" aria-label="다음 달">›</button></div>'+
    '<div class="cal">'+cells+'</div></section>'+
    '<div><h2>'+(sd.getMonth()+1)+'월 '+sd.getDate()+'일 ('+WD[sd.getDay()]+')'+(ui.sel===TODAY?' · 오늘':'')+'</h2>'+
    '<p class="sub">이날 할 루틴을 고르세요.</p></div>'+
    (chips?'<div class="chips">'+chips+'</div>':'<p class="empty">루틴 탭에서 루틴을 먼저 만들어 주세요.</p>')+
    (exs?'<ul class="plain exlist">'+exs+'</ul>':(chips?'<p class="empty">'+(routine?'이 루틴에 담긴 종목이 없어요.':'루틴을 누르면 담아 둔 종목이 나와요.')+'</p>':''));
}

function viewTrends(){
  if(!ui.trendEx||!exById(ui.trendEx)){
    const withData=S.exercises.find(e=>series(e.id).length);
    ui.trendEx=(withData||S.exercises[0]||{}).id||null;
  }
  const chips=S.exercises.map(e=>'<button type="button" class="chip" aria-pressed="'+(e.id===ui.trendEx)+'" data-act="trendEx" data-id="'+e.id+'">'+esc(e.name)+'</button>').join('');
  let stats='';
  if(ui.trendEx){
    const s=series(ui.trendEx);
    if(s.length){
      const lastV=s[s.length-1].v,best=Math.max.apply(null,s.map(p=>p.v));
      const prev=s.length>1?s[s.length-2].v:null;
      const diff=prev?((lastV-prev)/prev*100):null;
      stats='<dl class="stats"><div class="stat"><dt>최근 ('+md(s[s.length-1].date)+')</dt><dd>'+fmt(lastV)+'<small>kg</small></dd></div>'+
        '<div class="stat"><dt>최고</dt><dd>'+fmt(best)+'<small>kg</small></dd></div>'+
        '<div class="stat"><dt>직전 대비</dt><dd>'+(diff==null?'–':(diff>0?'+':'')+fmt(diff)+'<small>%</small>')+'</dd></div></dl>';
    }
  }
  const w=Object.keys(S.weights).sort();
  const wl=w.slice(-5).reverse().map(d=>'<li><span class="grow">'+d.replace(/-/g,'. ')+'</span><span class="num" style="font-size:18px;font-weight:600">'+fmt(S.weights[d])+' kg</span>'+
    '<button type="button" class="del" data-act="delWeight" data-id="'+d+'">삭제</button></li>').join('');
  return '<div><h2>종목별 총합 무게</h2><p class="sub">하루 총합 무게 = 세트마다 kg × 반복 횟수를 모두 더한 값</p></div>'+
    (chips?'<div class="chips">'+chips+'</div>':'<p class="empty">종목을 등록하고 기록을 남기면 추세가 보여요.</p>')+
    (ui.trendEx?'<section class="card">'+stats+'<div class="chart" id="chart-vol"></div></section>':'')+
    '<div><h2>몸무게</h2><p class="sub">같은 날짜에 다시 기록하면 값이 바뀌어요.</p></div>'+
    '<form class="wform" data-form="addWeight"><input type="date" id="w-date" value="'+TODAY+'" max="'+TODAY+'" aria-label="날짜">'+
    '<input type="number" id="w-kg" inputmode="decimal" min="1" max="500" step="0.1" placeholder="kg" aria-label="몸무게 kg">'+
    '<button class="btn" type="submit">기록</button></form>'+
    '<section class="card"><div class="chart" id="chart-w"></div>'+(wl?'<ul class="plain list">'+wl+'</ul>':'')+'</section>';
}

/* ---------- chart ---------- */
function ticks(min,max){
  if(min===max){const p=Math.max(1,Math.abs(min)*0.1);min-=p;max+=p;}
  const raw=(max-min)/4,mag=Math.pow(10,Math.floor(Math.log10(raw))),n=raw/mag;
  const step=(n<1.5?1:n<3?2:n<7?5:10)*mag;
  const lo=Math.floor(min/step)*step,hi=Math.ceil(max/step)*step,t=[];
  for(let v=lo;v<=hi+step/2;v+=step)t.push(Number(v.toFixed(6)));
  return t;
}
function drawChart(el,pts,color,emptyMsg){
  if(!el)return;
  if(!pts.length){el.innerHTML='<p class="empty">'+emptyMsg+'</p>';return;}
  const W=Math.max(260,el.clientWidth),H=210,m={l:50,r:16,t:26,b:26};
  const xs=pts.map(p=>parse(p.date).getTime()),x0=xs[0],x1=xs[xs.length-1];
  const tk=ticks(Math.min.apply(null,pts.map(p=>p.v)),Math.max.apply(null,pts.map(p=>p.v)));
  const y0=tk[0],y1=tk[tk.length-1],iw=W-m.l-m.r,ih=H-m.t-m.b;
  const X=t=>x1===x0?m.l+iw/2:m.l+(t-x0)/(x1-x0)*iw;
  const Y=v=>m.t+ih-(v-y0)/(y1-y0)*ih;
  const P=pts.map((p,i)=>[X(xs[i]),Y(p.v)]);
  let s='<svg viewBox="0 0 '+W+' '+H+'" height="'+H+'" role="img" aria-label="추세 그래프">';
  tk.forEach(v=>{s+='<line x1="'+m.l+'" x2="'+(W-m.r)+'" y1="'+Y(v)+'" y2="'+Y(v)+'" stroke="var(--line)" stroke-width="1"/>'+
    '<text x="'+(m.l-8)+'" y="'+(Y(v)+4)+'" text-anchor="end">'+fmt(v)+'</text>';});
  if(P.length>1){
    const line=P.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
    s+='<path d="'+line+' L'+P[P.length-1][0].toFixed(1)+' '+(m.t+ih)+' L'+P[0][0].toFixed(1)+' '+(m.t+ih)+' Z" fill="'+color+'" opacity=".12"/>'+
       '<path d="'+line+'" fill="none" stroke="'+color+'" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>';
  }
  P.forEach((p,i)=>{const lastP=i===P.length-1;
    s+='<circle cx="'+p[0]+'" cy="'+p[1]+'" r="'+(lastP?5:3)+'" fill="'+(lastP?color:'var(--surface)')+'" stroke="'+color+'" stroke-width="2"/>';});
  const lp=P[P.length-1];
  s+='<text x="'+lp[0]+'" y="'+(lp[1]-11)+'" text-anchor="'+(P.length>1?'end':'middle')+'" style="fill:var(--ink);font-weight:700;font-size:15px">'+fmt(pts[pts.length-1].v)+'</text>';
  if(P.length>1){
    s+='<text x="'+m.l+'" y="'+(H-6)+'" text-anchor="start">'+md(pts[0].date)+'</text>'+
       '<text x="'+(W-m.r)+'" y="'+(H-6)+'" text-anchor="end">'+md(pts[pts.length-1].date)+'</text>';
  }else{
    s+='<text x="'+lp[0]+'" y="'+(H-6)+'" text-anchor="middle">'+md(pts[0].date)+' · 기록이 2번 이상 쌓이면 선으로 이어져요</text>';
  }
  s+='</svg><div class="tip"></div>';
  el.innerHTML=s;
  const svg=el.querySelector('svg'),tip=el.querySelector('.tip');
  const move=ev=>{
    const r=svg.getBoundingClientRect(),px=(ev.clientX-r.left)/r.width*W;
    let k=0;P.forEach((p,i)=>{if(Math.abs(p[0]-px)<Math.abs(P[k][0]-px))k=i;});
    tip.textContent=md(pts[k].date)+' · '+fmt(pts[k].v)+' kg';
    tip.style.display='block';
    tip.style.left=Math.min(Math.max(P[k][0]/W*r.width,50),r.width-50)+'px';
  };
  svg.addEventListener('pointermove',move);svg.addEventListener('pointerdown',move);
  svg.addEventListener('pointerleave',()=>{tip.style.display='none';});
}
function drawTrends(){
  if(ui.trendEx)drawChart($('#chart-vol'),series(ui.trendEx),'var(--accent)','아직 이 종목의 기록이 없어요. 기록 탭에서 세트를 입력해 보세요.');
  drawChart($('#chart-w'),Object.keys(S.weights).sort().map(d=>({date:d,v:Number(S.weights[d])})),'var(--weight)','몸무게를 기록하면 변화가 그래프로 보여요.');
}
let rz;window.addEventListener('resize',()=>{clearTimeout(rz);rz=setTimeout(()=>{if(ui.ready&&ui.tab==='trends')drawTrends();},150);});

/* ---------- actions ---------- */
function armed(btn){
  if(btn.classList.contains('armed'))return true;
  const old=btn.textContent;btn.classList.add('armed');btn.textContent='삭제 확인';
  setTimeout(()=>{if(btn.isConnected){btn.classList.remove('armed');btn.textContent=old;}},3000);
  return false;
}
function refreshDay(id){
  const d=getDay(ui.sel),el=document.getElementById('sum-'+id);
  if(el){const sets=d&&d.entries[id];el.textContent=sumText(sets);el.classList.toggle('done',hasReps(sets));}
  const c=document.querySelector('.cal button[data-d="'+ui.sel+'"]');if(c)c.classList.toggle('has',dayHasLog(d));
}
const A={
  seed(){
    const names=['스쿼트','레그프레스','레그컬','벤치프레스','랫풀다운','숄더프레스'];
    S.exercises=names.map(n=>({id:uid('e'),name:n}));
    S.routines=[{id:uid('r'),name:'하체A',exIds:S.exercises.slice(0,3).map(e=>e.id)},{id:uid('r'),name:'상체A',exIds:S.exercises.slice(3).map(e=>e.id)}];
    save('core');render();
  },
  delEx(b){if(!armed(b))return;const id=b.dataset.id;
    S.exercises=S.exercises.filter(e=>e.id!==id);S.routines.forEach(r=>r.exIds=r.exIds.filter(x=>x!==id));save('core');render();},
  delRoutine(b){if(!armed(b))return;S.routines=S.routines.filter(r=>r.id!==b.dataset.id);save('core');render();},
  togglePick(b){ui.pick=ui.pick===b.dataset.id?null:b.dataset.id;render();},
  toggleInRoutine(b){const r=S.routines.find(x=>x.id===b.dataset.r);if(!r)return;
    const i=r.exIds.indexOf(b.dataset.id);if(i>=0)r.exIds.splice(i,1);else r.exIds.push(b.dataset.id);save('core');render();},
  rmFromRoutine(b){const r=S.routines.find(x=>x.id===b.dataset.r);if(!r)return;r.exIds=r.exIds.filter(x=>x!==b.dataset.id);save('core');render();},
  day(b){ui.sel=b.dataset.d;ui.openEx=null;render();},
  prevMonth(){if(--ui.vm<0){ui.vm=11;ui.vy--;}render();},
  nextMonth(){if(++ui.vm>11){ui.vm=0;ui.vy++;}render();},
  goToday(){const t=new Date();ui.sel=TODAY;ui.vy=t.getFullYear();ui.vm=t.getMonth();ui.openEx=null;render();},
  pickRoutine(b){const d=getDay(ui.sel,true);d.routineId=d.routineId===b.dataset.id?null:b.dataset.id;ui.openEx=null;saveDay(ui.sel);render();},
  openEx(b){ui.openEx=ui.openEx===b.dataset.id?null:b.dataset.id;render();},
  setInc(b){const d=getDay(ui.sel,true),id=b.dataset.id,sets=d.entries[id]||(d.entries[id]=[]);
    if(sets.length>=20)return;const l=sets[sets.length-1];sets.push({kg:l?l.kg:'',reps:l?l.reps:''});saveDay(ui.sel);render();},
  setDec(b){const d=getDay(ui.sel,true),sets=d.entries[b.dataset.id];if(!sets||!sets.length)return;sets.pop();saveDay(ui.sel);render();},
  copyLast(b){const id=b.dataset.id,last=lastRecord(id,ui.sel);if(!last)return;
    getDay(ui.sel,true).entries[id]=last.sets.map(s=>({kg:s.kg,reps:s.reps}));saveDay(ui.sel);render();},
  trendEx(b){ui.trendEx=b.dataset.id;render();},
  delWeight(b){if(!armed(b))return;delete S.weights[b.dataset.id];save('core');render();}
};
document.addEventListener('click',ev=>{
  const t=ev.target.closest('[data-tab]');if(t){setTab(t.dataset.tab);return;}
  const b=ev.target.closest('[data-act]');if(b&&A[b.dataset.act])A[b.dataset.act](b);
});
document.addEventListener('input',ev=>{
  const el=ev.target;if(!el.dataset||!el.dataset.in)return;
  const d=getDay(ui.sel,true),sets=d.entries[el.dataset.id];if(!sets)return;
  const s=sets[Number(el.dataset.i)];if(!s)return;
  const v=el.value===''?'':Math.max(0,Number(el.value));
  s[el.dataset.in]=(v===''||isNaN(v))?'':v;
  saveDay(ui.sel);refreshDay(el.dataset.id);
});
document.addEventListener('submit',ev=>{
  const f=ev.target.dataset.form;if(!f)return;ev.preventDefault();
  if(f==='addEx'){
    const inp=$('#new-ex'),name=inp.value.trim();if(!name)return;
    if(S.exercises.some(e=>e.name===name)){inp.select();return;}
    S.exercises.push({id:uid('e'),name:name});save('core');render();$('#new-ex').focus();
  }else if(f==='addRoutine'){
    const name=$('#new-routine').value.trim();if(!name)return;
    const r={id:uid('r'),name:name,exIds:[]};S.routines.push(r);ui.pick=r.id;save('core');render();
  }else if(f==='addWeight'){
    const dt=$('#w-date').value,kg=Number($('#w-kg').value);
    if(!dt||!(kg>0))return;S.weights[dt]=kg;save('core');render();
  }
});

/* ---------- start ---------- */
async function init(){
  let ok=false;
  try{
    if(window.claude&&typeof window.claude.use==='function'){
      const res=await Promise.race([
        (async()=>{
          const r=await Promise.all([window.claude.use('db'),window.claude.use('user')]);
          const me=r[1]?await r[1].id():null;
          if(!r[0]||!me)return null;
          const col=r[0].collection('data/users/'+me);
          return {col:col,snap:await col.get()};
        })(),
        new Promise(r=>setTimeout(()=>r(null),12000))
      ]);
      if(res){store.col=res.col;store.mode='cloud';res.snap.docs.forEach(d=>applyDoc(d.id,d.data()));ok=true;}
    }
  }catch(e){}
  if(!ok)loadLocal();
  ui.ready=true;idleStatus();
  const h=location.hash.slice(1);
  ui.tab=TABS.indexOf(h)>=0?h:(S.exercises.length?'log':'exercises');
  render();
}
render();init();
})();
</script>
